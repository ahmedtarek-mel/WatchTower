# WatchTower Environment Configuration
# Copy this to .env and fill in your values

# MLflow
WATCHTOWER_MLFLOW_TRACKING_URI=http://localhost:5000
WATCHTOWER_MLFLOW_EXPERIMENT_NAME=watchtower-intrusion-detection

# Training
WATCHTOWER_RANDOM_SEED=42
WATCHTOWER_XGB_N_ESTIMATORS=100
WATCHTOWER_OPTUNA_N_TRIALS=50

# GPU (set to true to force CPU training)
WATCHTOWER_FORCE_CPU=false

# API
WATCHTOWER_API_HOST=0.0.0.0
WATCHTOWER_API_PORT=8000

# Logging
WATCHTOWER_LOG_LEVEL=INFO
WATCHTOWER_LOG_TO_FILE=true
